# {{ ansible_managed }}
[req]
distinguished_name = req_dn
req_extensions = v3_req
prompt = no

[req_dn]
CN = {{ certs_role_nginx_cn }}

# OpenSSL 3: inline SAN (section indirection @san can fail with "Error checking request extension section v3_req")
[v3_req]
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = DNS:{{ certs_role_nginx_passthrough_host }}, DNS:localhost, IP:127.0.0.1
